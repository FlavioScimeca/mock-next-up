{
  "name": "app",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "build": "bun run src/script/app-build.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "render:test": "bun scripts/render-test.ts",
    "install:sharp:linux-arm64-musl": "bun add --cpu=arm64 --os=linux --optional @img/sharp-linuxmusl-arm64@0.35.0 @img/sharp-libvips-linuxmusl-arm64@1.3.0"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "elysia": "latest",
    "evlog": "^2.18.1",
    "logestic": "^1.2.4",
    "sharp": "0.35.0"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "0.35.0",
    "@img/sharp-libvips-linux-x64": "1.3.0",
    "@img/sharp-linuxmusl-arm64": "0.35.0",
    "@img/sharp-libvips-linuxmusl-arm64": "1.3.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^6.0.3"
  }
}
