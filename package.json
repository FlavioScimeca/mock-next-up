{
  "name": "app",
  "version": "1.0.50",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "render:test": "tsx scripts/render-test.ts",
    "postinstall": "node scripts/prepare-vercel.mjs",
    "prepare:vercel": "node scripts/prepare-vercel.mjs",
    "install:sharp:linux-arm64-musl": "npm install --no-save --include=optional @img/sharp-linuxmusl-arm64@0.35.0 @img/sharp-libvips-linuxmusl-arm64@1.3.0"
  },
  "dependencies": {
    "@elysiajs/node": "^1.4.5",
    "@img/sharp-wasm32": "0.35.0",
    "elysia": "1.4.28",
    "evlog": "^2.18.1",
    "sharp": "0.35.0"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.0",
    "@img/sharp-libvips-linuxmusl-arm64": "1.3.0",
    "@img/sharp-linux-x64": "0.35.0",
    "@img/sharp-linuxmusl-arm64": "0.35.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3"
  }
}
