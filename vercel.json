{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=optional",
  "functions": {
    "src/index.ts": {
      "includeFiles": [
        "node_modules/@img/**",
        "node_modules/sharp/**",
        "src/assets/**"
      ]
    }
  },
  "env": {
    "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
  }
}
